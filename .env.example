# Frontend (read by Vite at build time). Leave empty for local-only mode (no login, no sync).
# With these set, Curlion is sign-in only: the app and /docs pages require a Supabase account.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Netlify Edge Function "mock" (Netlify > Site configuration > Environment variables).
# Both required for /mock/* URLs. Mark the service role key as secret; never prefix it with VITE_.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
